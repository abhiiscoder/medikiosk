# ============================================================
# MEDiKIOSK Backend Environment Configuration (Phase 01)
# ============================================================

# HTTP Server Port
PORT=5000

# Execution Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/medikiosk

# CORS Origin for Frontend Application
CORS_ORIGIN=http://localhost:5173

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# ============================================================
# Google Gemini API Configuration (Foundation 03)
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: Gemini request timeout in milliseconds (default: 30000)
# GEMINI_TIMEOUT_MS=30000

# ============================================================
# OpenRouter AI Configuration (Secondary Provider)
# ============================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional: OpenRouter request timeout in milliseconds (default: 45000)
# OPENROUTER_TIMEOUT_MS=45000

# ============================================================
# Document Upload (Phase 06)
# ============================================================
# Optional: Override default upload directory (default: uploads/)
# MEDICAL_DOCUMENT_STORAGE_PATH=

